{
  "dashboard": {
    "title": "Agent Performance Metrics",
    "tags": ["agents", "performance"],
    "timezone": "browser",
    "schemaVersion": 38,
    "version": 1,
    "refresh": "1m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "type": "graph",
        "title": "Agent Task Completion Rate",
        "targets": [
          {
            "expr": "rate(agent_tasks_completed_total{agent_id=\"$agent\"}[5m])",
            "legendFormat": "{{agent_name}}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          { "label": "Tasks/min", "format": "short" },
          { "show": false }
        ]
      },
      {
        "id": 2,
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "type": "graph",
        "title": "Agent Success Rate",
        "targets": [
          {
            "expr": "rate(agent_tasks_completed_total{agent_id=\"$agent\",status=\"success\"}[5m]) / rate(agent_tasks_total{agent_id=\"$agent\"}[5m]) * 100",
            "legendFormat": "{{agent_name}}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          { "label": "Success %", "format": "percent", "max": 100, "min": 0 },
          { "show": false }
        ],
        "thresholds": [
          {
            "value": 95,
            "colorMode": "critical",
            "op": "lt",
            "fill": true,
            "line": true
          }
        ]
      },
      {
        "id": 3,
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "type": "stat",
        "title": "Average Rating",
        "targets": [
          {
            "expr": "avg(agent_rating{agent_id=\"$agent\"})",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "graphMode": "none",
          "colorMode": "value",
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "decimals": 2,
            "max": 5,
            "min": 0,
            "color": { "mode": "thresholds" },
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": 0, "color": "red" },
                { "value": 3.5, "color": "yellow" },
                { "value": 4.5, "color": "green" }
              ]
            }
          }
        }
      },
      {
        "id": 4,
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "type": "stat",
        "title": "Total Revenue",
        "targets": [
          {
            "expr": "sum(agent_revenue_total{agent_id=\"$agent\"})",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        },
        "fieldConfig": {
          "defaults": {
            "unit": "currencyUSD",
            "decimals": 2
          }
        }
      },
      {
        "id": 5,
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "type": "stat",
        "title": "Active Contracts",
        "targets": [
          {
            "expr": "count(rental_contract_status{agent_id=\"$agent\",status=\"active\"})",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "graphMode": "area",
          "colorMode": "value"
        }
      },
      {
        "id": 6,
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 16 },
        "type": "graph",
        "title": "Task Execution Time Distribution",
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(agent_task_duration_seconds_bucket{agent_id=\"$agent\"}[5m]))",
            "legendFormat": "p50",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "histogram_quantile(0.95, rate(agent_task_duration_seconds_bucket{agent_id=\"$agent\"}[5m]))",
            "legendFormat": "p95",
            "refId": "B",
            "datasource": "Prometheus"
          },
          {
            "expr": "histogram_quantile(0.99, rate(agent_task_duration_seconds_bucket{agent_id=\"$agent\"}[5m]))",
            "legendFormat": "p99",
            "refId": "C",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          { "label": "Seconds", "format": "s" },
          { "show": false }
        ]
      },
      {
        "id": 7,
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 16 },
        "type": "graph",
        "title": "Resource Utilization",
        "targets": [
          {
            "expr": "avg(agent_cpu_usage{agent_id=\"$agent\"})",
            "legendFormat": "CPU %",
            "refId": "A",
            "datasource": "Prometheus"
          },
          {
            "expr": "avg(agent_memory_usage_bytes{agent_id=\"$agent\"}) / 1024 / 1024 / 1024",
            "legendFormat": "Memory GB",
            "refId": "B",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          { "label": "Usage", "format": "short" },
          { "show": true, "label": "GB", "format": "decgbytes" }
        ],
        "seriesOverrides": [
          {
            "alias": "Memory GB",
            "yaxis": 2
          }
        ]
      },
      {
        "id": 8,
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
        "type": "graph",
        "title": "Error Rate by Type",
        "targets": [
          {
            "expr": "rate(agent_errors_total{agent_id=\"$agent\"}[5m])",
            "legendFormat": "{{error_type}}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "yaxes": [
          { "label": "Errors/sec", "format": "short" },
          { "show": false }
        ]
      },
      {
        "id": 9,
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 36 },
        "type": "bargauge",
        "title": "Capability Usage",
        "targets": [
          {
            "expr": "sum(agent_capability_usage_total{agent_id=\"$agent\"}) by (capability)",
            "legendFormat": "{{capability}}",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "options": {
          "orientation": "horizontal",
          "displayMode": "gradient",
          "showUnfilled": true
        }
      },
      {
        "id": 10,
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 36 },
        "type": "heatmap",
        "title": "Task Execution Heatmap",
        "targets": [
          {
            "expr": "sum(rate(agent_task_duration_seconds_bucket{agent_id=\"$agent\"}[5m])) by (le)",
            "format": "heatmap",
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "dataFormat": "tsbuckets",
        "yAxis": { "format": "s", "logBase": 1 },
        "cards": { "cardPadding": 2 }
      },
      {
        "id": 11,
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 46 },
        "type": "table",
        "title": "Recent Reviews",
        "targets": [
          {
            "expr": "agent_review_rating{agent_id=\"$agent\"}",
            "format": "table",
            "instant": true,
            "refId": "A",
            "datasource": "Prometheus"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "__name__": true },
              "renameByName": {
                "rating": "Rating",
                "quality_score": "Quality",
                "speed_score": "Speed",
                "communication_score": "Communication",
                "comment": "Comment",
                "created_at": "Date"
              }
            }
          }
        ]
      }
    ],
    "templating": {
      "list": [
        {
          "name": "agent",
          "type": "query",
          "datasource": "Prometheus",
          "query": "label_values(agent_info, agent_id)",
          "multi": false,
          "includeAll": false,
          "current": { "text": "Select Agent", "value": "" },
          "refresh": 1
        },
        {
          "name": "time_range",
          "type": "interval",
          "query": "1m,5m,15m,1h,6h,12h,24h",
          "current": { "text": "5m", "value": "5m" }
        }
      ]
    }
  }
}
